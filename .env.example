NODE_ENV=development
PORT=8081
# URL pública del backend (webhook Stripe) y del frontend (retorno de Checkout).
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NODE_ENV=development
PORT=8080
APP_URL=https://tu-api.example
FRONTEND_URL=https://tu-frontend.example
CORS_ORIGIN=https://tu-frontend.example

# Pagos
PAYMENT_CURRENCY=usd

# Almacenamiento privado de archivos académicos (Cloudflare R2, solo backend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Seguridad
LOGIN_RATE_LIMIT=20
