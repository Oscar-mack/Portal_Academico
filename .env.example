# Copia este archivo como .env.development y .env.production, y completa
# cada uno con tus propios valores. Nunca subas .env.development ni
# .env.production reales a git (ya están bloqueados en .gitignore).

# ---- Base de datos (Neon / PostgreSQL) ----
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- General ----
PORT=8080
CORS_ORIGIN=*
# URL pública del backend (usada para las redirecciones de Stripe Checkout)
APP_URL=http://localhost:8080
