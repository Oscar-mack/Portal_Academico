NODE_ENV=development
PORT=8081
# URL pública del backend (webhook Stripe) y del frontend (retorno de Checkout).
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Opt-in solo para vistas previas de Figma; por defecto se rechazan.
CORS_ALLOW_FIGMA_PREVIEWS=false

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NODE_ENV=development
PORT=8080
APP_URL=https://tu-api.example
FRONTEND_URL=https://tu-frontend.example
CORS_ORIGIN=https://tu-frontend.example
# Mantener false salvo que se autoricen explícitamente vistas previas de Figma.
CORS_ALLOW_FIGMA_PREVIEWS=false

# Pagos
PAYMENT_CURRENCY=usd

# Almacenamiento privado de archivos académicos (Cloudflare R2, solo backend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Proveedor de almacenamiento: vacío o "r2" (Cloudflare R2, por defecto), "s3" (S3 compatible),
# "supabase" (API nativa de Supabase Storage) o "gdrive" (Google Drive OAuth, prueba de ensayo).
# Cada proveedor usa solo su propio grupo de variables.
STORAGE_PROVIDER=
# Supabase: https://<ref>.storage.supabase.co/storage/v1/s3 (el path es obligatorio).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Supabase Storage nativo (STORAGE_PROVIDER=supabase). Solo backend; el bucket debe ser privado.
# SUPABASE_URL: https://<ref>.supabase.co. SUPABASE_SERVICE_ROLE_KEY es un secreto: nunca en el frontend ni en el repositorio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Diagnóstico temporal (desactivado por defecto): true registra un fragmento filtrado de los 400 de texto del proveedor.
STORAGE_DEBUG_BODY=
# Google Drive (STORAGE_PROVIDER=gdrive, solo ensayo). Nunca configurar estas variables en el frontend.
# GOOGLE_REDIRECT_URI debe coincidir exactamente con el URI registrado en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Clave aleatoria de al menos 32 caracteres; cifra el token local y GOOGLE_REFRESH_TOKEN_ENC (AES-256-GCM).
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Token cifrado exportado desde el almacén local con scripts/export-google-refresh-token.js.
# Tiene prioridad sobre el archivo local y es de solo lectura; nunca almacenar aquí el token en texto plano.
GOOGLE_REFRESH_TOKEN_ENC=
# Opcionales: almacén local cifrado (por defecto ./.secrets/google-drive-token.enc), ID de carpeta creada por la app
# (no un folder ID arbitrario con drive.file) y límite de subida en bytes (10 MiB por defecto, máximo 20 MiB).
GOOGLE_TOKEN_STORE_PATH=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAX_FILE_BYTES=

# Seguridad
LOGIN_RATE_LIMIT=20
